// storage.rules
// Copy these into Firebase Console → Storage → Rules

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Family photos — only the guest themselves can upload their own
    match /family-photos/{phone} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.phone_number == phone;
    }

    // Outfit photos — only the guest themselves can upload
    match /outfits/{phone} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.phone_number == phone;
    }
  }
}
